{
  "name": "sow-generator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "NEXT_DIST_DIR=.next-verify PUPPETEER_SKIP_DOWNLOAD=true next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "knip": "knip --no-progress",
    "test": "vitest run",
    "backfill:canonicalize": "tsx tools/backfill-canonicalize-content.ts",
    "postinstall": "node -e \"process.exit(process.env.PUPPETEER_SKIP_DOWNLOAD === 'true' ? 0 : 1)\" || puppeteer browsers install chrome || puppeteer browsers install chromium || echo 'Warning: Failed to install browsers. PDF generation may not work.'",
    "install-chrome": "puppeteer browsers install chrome",
    "install-chromium": "puppeteer browsers install chromium",
    "install-browsers": "puppeteer browsers install chrome && puppeteer browsers install chromium"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webfeathers/SOW-Generator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/webfeathers/SOW-Generator/issues"
  },
  "homepage": "https://github.com/webfeathers/SOW-Generator#readme",
  "description": "",
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@supabase/supabase-js": "^2.53.0",
    "@tiptap/extension-image": "^3.4.2",
    "@tiptap/extension-table": "^3.0.9",
    "@tiptap/extension-table-cell": "^3.0.9",
    "@tiptap/extension-table-header": "^3.0.9",
    "@tiptap/extension-table-row": "^3.0.9",
    "@tiptap/pm": "^3.0.7",
    "@tiptap/react": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dotenv": "^17.2.1",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.29",
    "googleapis": "^133.0.0",
    "isomorphic-dompurify": "^3.16.0",
    "jsforce": "3.9.4",
    "next": "^15.5.29",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.7",
    "puppeteer-core": "^24.43.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "knip": "^6.45.1",
    "postcss": "^8.5.6",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
